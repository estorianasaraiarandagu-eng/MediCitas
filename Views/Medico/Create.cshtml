@model MediCitas.Models.Medico

@{
    ViewData["Title"] = "Registrar Médico";
}

<div class="container mt-4">
    <h2>Registrar Nuevo Médico</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Apellido</label>
                    <input asp-for="Apellido" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Especialidad</label>
                    <input asp-for="Especialidad" class="form-control" placeholder="Ej. Pediatría, Cardiología..." required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-control" />
                </div>
                <button type="submit" class="btn btn-success">Guardar Médico</button>
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </form>
        </div>
    </div>
</div>