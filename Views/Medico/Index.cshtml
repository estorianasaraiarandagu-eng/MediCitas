@model IEnumerable<MediCitas.Models.Medico>

@{
    ViewData["Title"] = "Gestión de Médicos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Médicos</h2>
        <a asp-action="Create" class="btn btn-primary">+ Registrar Nuevo Médico</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No hay médicos registrados actualmente.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Especialidad</th>
                    <th>Teléfono</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdMedico</td>
                        <td>@item.Nombre</td>
                        <td>@item.Apellido</td>
                        <td>@item.Especialidad</td>
                        <td>@item.Telefono</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>