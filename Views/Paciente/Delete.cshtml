@model MediCitas.Models.Paciente

@{
    ViewData["Title"] = "Eliminar Paciente";
}

<div class="container mt-4">
    <h2>Eliminar Paciente</h2>
    <div class="alert alert-danger mt-3">
        <h4>¿Estás seguro de que deseas eliminar a este paciente?</h4>
    </div>
    <div class="card col-md-6 shadow-sm mb-3">
        <div class="card-body">
            <p><strong>ID:</strong> @Model.IdPaciente</p>
            <p><strong>Nombre:</strong> @Model.Nombre</p>
            <p><strong>Teléfono:</strong> @Model.Telefono</p>
        </div>
    </div>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.IdPaciente" />
        <button type="submit" class="btn btn-danger">Sí, Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>