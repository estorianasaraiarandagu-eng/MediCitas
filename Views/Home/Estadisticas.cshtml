@{
    ViewData["Title"] = "Estadísticas del Sistema";
}

<div class="text-center mb-5">
    <h1 class="fw-bold" style="color: #1b3a2b;">📊 Panel de Estadísticas en Tiempo Real</h1>
    <p class="text-muted">Resumen analítico general de la base de datos médica.</p>
</div>

<div class="row text-white">
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm border-0 text-white" style="background-color: #1b3a2b;">
            <div class="card-body text-center py-4">
                <h5 class="card-title text-uppercase fs-6 fw-semibold text-light">Pacientes</h5>
                <h2 class="display-3 fw-bold my-2" style="color: #5ccda7;">@ViewBag.TotalPacientes</h2>
                <a asp-controller="Paciente" asp-action="Index" class="text-white text-decoration-underline small">Gestionar Pacientes</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm border-0 text-white" style="background-color: #2d6a4f;">
            <div class="card-body text-center py-4">
                <h5 class="card-title text-uppercase fs-6 fw-semibold text-light">Doctores</h5>
                <h2 class="display-3 fw-bold my-2" style="color: #5ccda7;">@ViewBag.TotalMedicos</h2>
                <a asp-controller="Medico" asp-action="Index" class="text-white text-decoration-underline small">Gestionar Doctores</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm border-0 text-dark" style="background-color: #5ccda7;">
            <div class="card-body text-center py-4">
                <h5 class="card-title text-uppercase fs-6 fw-semibold text-dark">Citas Agendadas</h5>
                <h2 class="display-3 fw-bold my-2 text-dark">@ViewBag.CitasAgendadas</h2>
                <a asp-controller="Cita" asp-action="IndexAgendadas" class="text-dark fw-bold text-decoration-underline small">Ver Agendadas</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm border-0 text-white" style="background-color: #495057;">
            <div class="card-body text-center py-4">
                <h5 class="card-title text-uppercase fs-6 fw-semibold text-light">Citas Canceladas</h5>
                <h2 class="display-3 fw-bold my-2 text-warning">@ViewBag.CitasCanceladas</h2>
                <a asp-controller="Cita" asp-action="IndexCanceladas" class="text-white text-decoration-underline small">Ver Canceladas</a>
            </div>
        </div>
    </div>
</div>