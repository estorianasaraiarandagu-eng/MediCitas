<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCitas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #f0f2f5;">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3" style="background-color: #1b3a2b;">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Cita" asp-action="IndexAgendadas" style="color: #5ccda7;">
                    🏥 MediCitas
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Paciente" asp-action="Index">Pacientes</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Medico" asp-action="Index">Doctores</a></li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="citasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Citas</a>
                            <ul class="dropdown-menu shadow" aria-labelledby="citasDropdown">
                                <li><a class="dropdown-item" asp-controller="Cita" asp-action="IndexAgendadas">Citas Agendadas</a></li>
                                <li><a class="dropdown-item" asp-controller="Cita" asp-action="IndexCanceladas">Citas Canceladas</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="clinicaDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">🩺 Gestión Clínica</a>
                            <ul class="dropdown-menu shadow" aria-labelledby="clinicaDropdown">
                                <li><a class="dropdown-item" asp-controller="Cita" asp-action="AgendaDiaria">Agenda Diaria</a></li>
                                <li><a class="dropdown-item" asp-controller="Cita" asp-action="HistorialClinico">Historial Clínico</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Cita" asp-action="Especialidades">Especialidades Médicas</a></li>
                            </ul>
                        </li>

                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Estadisticas">Estadísticas</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3 bg-white mt-4">
        <div class="container">&copy; 2026 - MediCitas - Sistema Médico Profesional</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>