@model IEnumerable<MediCitas.Models.Cita>

@{
    ViewData["Title"] = "Citas Agendadas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📅 Listado de Citas Agendadas</h2>
        <a asp-action="Create" class="btn btn-primary">+ Agendar Nueva Cita</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center py-4 shadow-sm">
            No hay citas agendadas actualmente.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Paciente</th>
                    <th>Médico</th>
                    <th>Fecha y Hora</th>
                    <th>Motivo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdCita</td>
                        <td>@item.NombrePaciente</td>
                        <td>@item.NombreMedico</td>
                        <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Motivo</td>
                        <td><span class="badge bg-success">Agendada</span></td>
                        <td>
                            <a asp-action="Cancelar" asp-route-id="@item.IdCita" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Estás seguro de cancelar esta cita?');">Cancelar Cita</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>