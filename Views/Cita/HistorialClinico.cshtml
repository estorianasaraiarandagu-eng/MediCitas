@model IEnumerable<MediCitas.Models.ConsultaMedica>

@{
    ViewData["Title"] = "Historial Clínico";
}

<div class="container mt-4">
    <h2 class="mb-4">📋 Historial Clínico de Pacientes</h2>

    <!-- Filtro de Paciente -->
    <form method="get" class="row g-3 mb-4 p-3 bg-white shadow-sm rounded">
        <div class="col-md-9">
            <label class="form-label fw-bold">Seleccionar Paciente</label>
            <select name="idPaciente" class="form-select" required>
                <option value="">-- Seleccione un Paciente para ver su expediente --</option>
                @if (ViewBag.Pacientes != null)
                {
                    foreach (var pac in ViewBag.Pacientes)
                    {
                        bool seleccionado = ViewBag.PacienteSeleccionado != null && (int)ViewBag.PacienteSeleccionado == pac.IdPaciente;
                        <option value="@pac.IdPaciente" selected="@seleccionado">@pac.Nombre</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-success w-100">Consultar Historial</button>
        </div>
    </form>

    <!-- Resultados del Historial -->
    @if (Model != null && Model.Any())
    {
        foreach (var consulta in Model)
        {
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-dark text-white d-flex justify-content-between">
                    <span><strong>Fecha de Cita:</strong> @consulta.FechaCita.ToString("dd/MM/yyyy HH:mm")</span>
                    <span><strong>Médico:</strong> @consulta.NombreMedico</span>
                </div>
                <div class="card-body bg-white">
                    <p><strong>Diagnóstico:</strong> @consulta.Diagnostico</p>
                    <p><strong>Receta Médica:</strong> <span class="text-success fw-bold">@consulta.Receta</span></p>
                    <p class="text-muted mb-0"><strong>Observaciones:</strong> @consulta.Observaciones</p>
                </div>
            </div>
        }
    }
    else if (ViewBag.PacienteSeleccionado != null)
    {
        <div class="alert alert-warning text-center">Este paciente aún no registra consultas médicas previas.</div>
    }
    else
    {
        <div class="alert alert-info text-center">Seleccione un paciente arriba para consultar su expediente médico.</div>
    }
</div>